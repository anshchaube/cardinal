      include "traction.f"

c-----------------------------------------------------------------------
      subroutine useric(ix,iy,iz,eg) ! set up initial conditions

c      implicit none

      integer ix,iy,iz,eg

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      ux   = 0.0
      uy   = 0.0
      uz   = 0.0
      temp = 0.0


      return
      end

C-----------------------------------------------------------------------
      subroutine userchk()
      include 'SIZE'
      include 'TOTAL'
      
      common /nrsscptr/ nrs_scptr(9)
      integer*8         nrs_scptr

      real tracx(lx1,ly1,lz1,lelv),tracy(lx1,ly1,lz1,lelv),
     $     tracz(lx1,ly1,lz1,lelv),test(lx1,ly1,lz1,lelv)
      real trxmax,trymax,trzmax,trxmin,trymin,trzmin

      real uinmax
      integer js1,jf1,jskip1,js2,jf2,jskip2,ie

      integer ntot
      integer trsidesets(1)

      integer step_now, step_prev
      common /steps/ step_now, step_prev

c     Point for torque calculation
      real x0(3)
      data x0 /3*0.0/

      integer bIDs(1), iobj_wall(1)
      common /local_obj/ iobj_wall

      real geid(lx1,ly1,lz1,lelv)

      ntot = lx1*ly1*lz1*nelv
      call rzero(geid,ntot)

c     drag calculation
      if(istep.eq.0) then
        step_prev = istep-1
        bIDs(1) = 2
        call create_obj(iobj_wall(1),bIDs,1)

        do ie=1,nelv
          do i=1,lx1*ly1*lz1
            geid(i,1,1,ie) = lglel(ie)*1.0
          enddo
        enddo
        call outpost(geid,vy,vz,pr,t,'eid')
      endif

      step_now = istep     

      ! calc the drag
      if (step_prev.ne.step_now) then
        call estimate_strouhal
        call torque_calc(1.,x0,.true.,.false.)
      endif
      ! update steps
      step_prev = step_now

      computecfl=0
      !call pressure_integral()
      if (computecfl.eq.1) then
      ntot = lx1*ly1*lz1*nelv
      dt = 5e-3    ! dt has to mach the value in par file
      call compute_cfl(cfl,vx,vy,vz,dt)
      if(nid.eq.0) write(6,*) "cfl in nek is ",cfl
      if (cfl.gt.3.0) then
      call outpost(vx,vy,vz,cflf,pr,'cfl')
      clf_max = glmax(cflf,ntot)
      clf_max_x = 0.0
      clf_max_y = 0.0
      clf_max_z = 0.0
      do i =1,ntot
         if(cflf(i,1,1,1).ge.clf_max) then
            clf_max_x = xm1(i,1,1,1)
            clf_max_y = ym1(i,1,1,1)
            clf_max_z = zm1(i,1,1,1)
         endif
      enddo
      vec = sqrt(clf_max_x**2 + clf_max_y**2+ clf_max_z**2)
      if(nid.eq.0) write(6,*) "vec",vec
      if(vec.gt.0.0) then
        write(6,*) "max clf xyz: ", clf_max_x,clf_max_y,clf_max_z
      endif
      endif
      endif

c     for traction calculation

c     calculating traction

      trsidesets=(/ 2 /)
      call sideset_traction(tracx,tracy,tracz,trsidesets,1,1)

      nrs_scptr(7) = loc(tracx)
      nrs_scptr(8) = loc(tracy)
      nrs_scptr(9) = loc(tracz)

      if(mod(istep,1).eq.0) then
       !call outpost(tracx,tracy,tracz,pr,t,'tri')
      endif

      trxmax = glmax(tracx,ntot)
      trymax = glmax(tracy,ntot)
      trzmax = glmax(tracz,ntot)
      trxmin = glmin(tracx,ntot)
      trymin = glmin(tracy,ntot)
      trzmin = glmin(tracz,ntot)

      if(nio.eq.0) then
        write(*,15) trxmax,trymax,trzmax
        write(*,16) trxmin,trymin,trzmin
      endif


15    format(1p3e16.8,': max traction x/y/z')
16    format(1p3e16.8,': min traction x/y/z')


      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat()   ! This routine to modify element vertices
      include 'SIZE'
      include 'TOTAL'


      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2()  ! This routine to modify mesh coordinates
      include 'SIZE'
      include 'TOTAL'

      integer ntot,i

      ntot = lx1*ly1*lz1*nelv

      do i =1,ntot
         xm1(i,1,1,1)=xm1(i,1,1,1)*0.01
         ym1(i,1,1,1)=ym1(i,1,1,1)*0.01
         zm1(i,1,1,1)=zm1(i,1,1,1)*0.01
      enddo

      do iel=1,nelv
      do ifc=1,2*ndim
        boundaryID(ifc,iel) = 0
        id_face = bc(5,ifc,iel,1)
        if (id_face.eq.1) then        ! surface 1 for inlet
           !cbc(ifc,iel,1) = 'v  '
           boundaryID(ifc,iel) = 1
        elseif (id_face.eq.2) then    ! surface 2 for cylinder
           !cbc(ifc,iel,1) = 'W  '
           boundaryID(ifc,iel) = 2
        elseif (id_face.eq.3) then    ! surface 3 for outlet
           !cbc(ifc,iel,1) = 'O  '
           boundaryID(ifc,iel) = 3
        elseif (id_face.eq.4) then    ! surface 4 for sym
           !cbc(ifc,iel,1) = 'SYM'
           boundaryID(ifc,iel) = 4
        elseif (id_face.eq.5) then    ! surface 5 for periodic_1
           !cbc(ifc,iel,1) = 'P  '
           !boundaryID(ifc,iel) = 5
        elseif (id_face.eq.6) then    ! surface 6 for periodic_2
           !cbc(ifc,iel,1) = 'P  '
           !boundaryID(ifc,iel) = 6
        endif
      enddo
      enddo

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3()
      include 'SIZE'
      include 'TOTAL'

      return
      end
c-------------------------------------------------------------------------
      subroutine avg_custom
      implicit none

      include 'SIZE'
      include 'TOTAL'
      real*8 vx_avg(lx1,ly1,lz1,lelt),vy_avg(lx1,ly1,lz1,lelt),
     & vz_avg(lx1,ly1,lz1,lelt),t_avg(lx1,ly1,lz1,lelt)
      real*8 vx_rms(lx1,ly1,lz1,lelt),vy_rms(lx1,ly1,lz1,lelt),
     & vz_rms(lx1,ly1,lz1,lelt)
      real Tx(lx1,ly1,lz1,lelt)
      real Ty(lx1,ly1,lz1,lelt)
      real Tz(lx1,ly1,lz1,lelt)
      real TKE(lx1,ly1,lz1,lelt)
      integer e,i,j,k,iip,iiq

      do i=1,lx1
      do j=1,ly1
      do k=1,lz1
      do e=1,lelt
         vx_avg(i,j,k,e)=0.0
         vy_avg(i,j,k,e)=0.0
         vz_avg(i,j,k,e)=0.0
         vx_rms(i,j,k,e)=0.0
         vy_rms(i,j,k,e)=0.0
         vz_rms(i,j,k,e)=0.0
      enddo
      enddo
      enddo
      enddo

      do iip=1,15
      do iiq=1,10

      call blank(initc(1),70)
      write(initc(1),7)iiq,iip

   7       format('/gpfs/alpine/nfu106/scratch/dzr5281/TAMU_new/'
     &'AVGRun',i2.2,'/avgtamu3_67peb0.f000',i2.2)
      call setics

      do i=1,lx1
      do j=1,ly1
      do k=1,lz1
      do e=1,lelt
         vx_avg(i,j,k,e)=vx_avg(i,j,k,e)+vx(i,j,k,e)/(150.0)
         vy_avg(i,j,k,e)=vy_avg(i,j,k,e)+vy(i,j,k,e)/(150.0)
         vz_avg(i,j,k,e)=vz_avg(i,j,k,e)+vz(i,j,k,e)/(150.0)
      enddo
      enddo
      enddo
      enddo

      enddo
      enddo

      do i=1,lx1
      do j=1,ly1
      do k=1,lz1
      do e=1,lelt
         vx(i,j,k,e)   = vx_avg(i,j,k,e)
         vy(i,j,k,e)   = vy_avg(i,j,k,e)
         vz(i,j,k,e)   = vz_avg(i,j,k,e)
      enddo
      enddo
      enddo
      enddo

      call outpost2(vx,vy,vz,pr,t,ldimt,'av2')

      do iip=1,15
      do iiq=1,10

      call blank(initc(1),70)
      write(initc(1),8)iiq,iip
   8       format('/gpfs/alpine/nfu106/scratch/dzr5281/TAMU_new/'
     &     'AVGRun',i2.2,'/rmstamu3_67peb0.f000',i2.2)
      call setics

      do i=1,lx1
      do j=1,ly1
      do k=1,lz1
      do e=1,lelt
         vx_rms(i,j,k,e)=vx_rms(i,j,k,e)+vx(i,j,k,e)/(150.0)
         vy_rms(i,j,k,e)=vy_rms(i,j,k,e)+vy(i,j,k,e)/(150.0)
         vz_rms(i,j,k,e)=vz_rms(i,j,k,e)+vz(i,j,k,e)/(150.0)
      enddo
      enddo
      enddo
      enddo

      enddo
      enddo

      do i=1,lx1
      do j=1,ly1
      do k=1,lz1
      do e=1,lelt
         Tx(i,j,k,e)=0.5*(vx_rms(i,j,k,e)-(vx_avg(i,j,k,e))**2)
         Ty(i,j,k,e)=0.5*(vy_rms(i,j,k,e)-(vy_avg(i,j,k,e))**2)
         Tz(i,j,k,e)=0.5*(vz_rms(i,j,k,e)-(vz_avg(i,j,k,e))**2)
	 TKE(i,j,k,e)=Tx(i,j,k,e)+Ty(i,j,k,e)+Tz(i,j,k,e)
      enddo
      enddo
      enddo
      enddo

      call outpost2(Tx,Ty,Tz,TKE,t,ldimt,'TKE')
      return
      end
c-----------------------------------------------------------------------
      subroutine pressure_integral()

      include 'SIZE'
      include 'TOTAL'

      real p_integral,norm(3)
      integer ifc,iel


      do iel=1,nelv
      do ifc=1,2*ndim
      if (boundaryID(ifc,iel).eq.2) then
         !call getSnormal(norm,i,j,k,ifc,iel) !This is not the correct way to get the normal I guess
         call surface_int(sint,sarea,p,iel,ifc)
         p_integral = p_integral + sint*0.1
      endif
      enddo
      enddo

      p_integral = glsum(p_integral,1)
      if (nid.eq.0) then
         write(6,*) "Integral of p dot n is: ", p_integral
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine estimate_strouhal

      include 'SIZE'
      include 'TOTAL'

      real tlast,vlast,tcurr,vcurr,t0,t1
      save tlast,vlast,tcurr,vcurr,t0,t1
      data tlast,vlast,tcurr,vcurr,t0,t1 / 6*0 /

      integer e,eg,eg0,e0

      eg0 = 3683          ! Identify element/processor in wake
      mid = gllnid(eg0)
      e0  = gllel (eg0)

      st  = 0

      if (nid.eq.mid) then

         tlast = tcurr
         vlast = vcurr

         tcurr = time
         vcurr = vy (1,ny1,1,e0)

         xcurr = xm1(1,ny1,1,e0)
         ycurr = ym1(1,ny1,1,e0)

         write(6,2) istep,time,vcurr,xcurr,ycurr
    2    format(i9,1p4e13.5,' vcurr')

         if (vlast.gt.0.and.vcurr.le.0) then ! zero crossing w/ negative slope
            t0  = t1
            t1  = tlast + (tcurr-tlast)*(vlast-0)/(vlast-vcurr)
            per = t1-t0
            if (per.gt.0) st = 1./per
         endif
      endif

      st = glmax(st,1)

      n  = nx1*ny1*nz1*nelv
      ux = glamax(vx,n)
      uy = glamax(vy,n)

      if (nid.eq.0.and.st.gt.0) write(6,1) istep,time,st,ux,uy
    1 format(i5,1p4e12.4,' Strouhal')

      return
      end
