      subroutine useric (ix,iy,iz,ieg)  ! Initial Conditions

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      ux   = 0.001
      uy   = 0.0
      uz   = 0.0

      temp = 0.

      return
      end
