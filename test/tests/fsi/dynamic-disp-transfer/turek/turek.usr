c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)  ! Initial Conditions

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      ux   = 0.001
      uy   = 0.0
      uz   = 0.0

      temp = 0.

      return
      end
c-----------------------------------------------------------------------
      subroutine userchk
      implicit none
      include 'SIZE'
      include 'TOTAL'

      common /nrsscptr/ nrs_scptr(9)
      integer*8         nrs_scptr


      real tr_x(lx1,ly1,lz1,lelv),tr_y(lx1,ly1,lz1,lelv)
      real tr_z(lx1,ly1,lz1,lelv)
      integer trsidesets(1)
      integer ntot

      integer emap_in(lelv)
      common /emaps/ emap_in
      real uin_avg, uin_max, emap_avg, emap_max


      ntot = lx1*ly1*lz1*nelt

c      uin_avg = emap_avg(vx, emap_in)
c      uin_max = emap_max(vx, emap_in)

c      if (nio.eq.0) then
c        write(*,*) "AVG INLET VELOCITY:", uin_avg
c        write(*,*) "MAX INLET VELOCITY:", uin_max
c      endif

      trsidesets=(/ 7 /)
      call sideset_traction(tr_x,tr_y,tr_z,trsidesets,1,1)

      nrs_scptr(4) = loc(tr_x)
      nrs_scptr(5) = loc(tr_y)
      nrs_scptr(6) = loc(tr_z)

      if (nio.eq.0) write(*,*) "userchk routines complete."

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat()   ! This routine to modify element vertices

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2()  ! This routine to modify mesh coordinates

      implicit none

      include 'SIZE'
      include 'TOTAL'

      integer iel, ifc, bid
      real test(lx1,ly1,lz1,lelv)
      integer emap_in(lelv)
      common /emaps/ emap_in

      call emap_sideset(emap_in, 1, 1)

      call rzero(test,lx1*ly1*lz1*nelv)

c     boundaryTypeMap = inlet, outlet, wall, wall, mv, sym, sym
      do iel=1,nelt
      do ifc=1,2*ndim
         bid = boundaryID(ifc,iel)
         if (bid.eq.1) then         
             cbc(ifc,iel,1) = 'v  '
         elseif (bid.eq.2) then     
             cbc(ifc,iel,1) = 'O  '
         elseif (bid.eq.3) then     
             cbc(ifc,iel,1) = 'W  '
         elseif (bid.eq.4) then     
             cbc(ifc,iel,1) = 'W  '
         elseif (bid.eq.5) then     
             cbc(ifc,iel,1) = 'SYM'
         elseif (bid.eq.6) then     
             cbc(ifc,iel,1) = 'SYM'
         elseif (bid.eq.7) then     
             cbc(ifc,iel,1) = 'MV '
         endif
      enddo
      enddo

c      call check_sidesets("bid")

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3

      include 'SIZE'
      include 'TOTAL'

      return
      end
