void velocityDirichletConditions(bcData *bc)
{
  if (bc->id==1)
  {
    bc->u = 1.0;
    bc->v = 0.0;
    bc->w = 0.0;
  }
  else
  {
    bc->u = bc->usrwrk[bc->idM + 4*bc->fieldOffset];
//    if (abs(bc->u) > 1e-16)
//      printf("Interface fluid vx:  %f\n", bc->u);
    bc->v = bc->usrwrk[bc->idM + 5*bc->fieldOffset];
//    if (abs(bc->v) > 1e-16)
//      printf("Interface fluid vy:  %f\n", bc->v);
    bc->w = bc->usrwrk[bc->idM + 6*bc->fieldOffset];
//    if (abs(bc->w) > 1e-16)
//      printf("Interface fluid vz:  %f\n", bc->w);

  }
}

void pressureDirichletConditions(bcData *bc)
{
  //const dfloat iU0delta = 20.0;
  //const dfloat un = bc->u*bc->nx + bc->v*bc->ny + bc->w*bc->nz;
  //const dfloat s0 = 0.5 * (1.0 - tanh(un*iU0delta));
  //bc->p = 1.0-0.5 * (bc->u*bc->u + bc->v*bc->v + bc->w*bc->w) * s0;
  bc->p = 1.0;
}

void meshVelocityDirichletConditions(bcData *bc)
{
  if(bc->id==2)
  {
    //bc->meshu = 0.0;
    //bc->meshv = 0.0;
    //bc->meshw = 0.0;
    bc->meshu = bc->usrwrk[bc->idM + 1*bc->fieldOffset];
//    if (abs(bc->meshu) > 1e-16)
//      printf("Mesh fluid vx:  %f\n", bc->meshu);
    bc->meshv = bc->usrwrk[bc->idM + 2*bc->fieldOffset];
//    if (abs(bc->meshv) > 1e-16)
//      printf("Mesh fluid vy:  %f\n", bc->meshv);
    bc->meshw = bc->usrwrk[bc->idM + 3*bc->fieldOffset];
//    if (abs(bc->meshw) > 1e-16)
//      printf("Mesh fluid vz:  %f\n", bc->meshw);
  }
}

